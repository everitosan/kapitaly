---
interface Props {
  title: string;
  description: string;
}

const { title, description } = Astro.props;
const base = import.meta.env.BASE_URL;
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="color-scheme" content="light dark" />
    <link rel="icon" type="image/png" href={`${base}favicon.png`} />
    <link rel="canonical" href={new URL(Astro.url.pathname, Astro.site)} />
    <title>{title}</title>
  </head>
  <body>
    <main class="doc">
      <a class="brand" href={base}>
        <img src={`${base}icon.png`} alt="" width="32" height="32" />
        KPTLY expenses
      </a>
      <slot />
      <p class="foot">KPTLY expenses · Everardo Sánchez Hernández · Ciudad de México, México</p>
    </main>
  </body>
</html>

<style is:global>
  /* Tokens de A-1 Duotono (fondos de la app y bloque menta de theme.frequency.custom). */
  :root {
    --bg: #f4f1ea;
    --ink: #141414;
    --muted: #6e695f;
    --card: #ffffff;
    --line: #e4dfd3;
    --mint-a: #bff4df;
    --mint-b: #6fd7b5;
  }
  @media (prefers-color-scheme: dark) {
    :root {
      --bg: #020903;
      --ink: #f4f1ea;
      --muted: #9c968a;
      --card: #1e1d1a;
      --line: #2e2c28;
      --mint-a: #a9edd3;
      --mint-b: #57c7a2;
    }
  }
  * {
    box-sizing: border-box;
    margin: 0;
    padding: 0;
  }
  html {
    -webkit-text-size-adjust: 100%;
  }
  body {
    background: var(--bg);
    color: var(--ink);
    font-family:
      -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif;
    -webkit-font-smoothing: antialiased;
    line-height: 1.35;
    padding: 28px 16px 64px;
  }
  .doc {
    max-width: 680px;
    margin: 0 auto;
  }
  .brand {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    font-weight: 800;
    font-size: 15px;
    letter-spacing: -0.01em;
    margin-bottom: 22px;
    color: inherit;
    text-decoration: none;
  }
  .brand img {
    display: block;
    border-radius: 9px;
  }
  .hero {
    border-radius: 28px;
    padding: 26px 24px;
    background: linear-gradient(135deg, var(--mint-a), var(--mint-b));
    color: #141414;
    margin-bottom: 28px;
  }
  .hero h1 {
    font-size: clamp(28px, 5vw, 40px);
    line-height: 1.05;
    letter-spacing: -0.03em;
    font-weight: 800;
  }
  .hero p {
    margin-top: 10px;
    font-size: 15px;
    font-weight: 600;
    color: #2b2b2b;
  }
  .hero a {
    color: inherit;
  }
  .summary {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(190px, 1fr));
    gap: 10px;
    margin-bottom: 30px;
  }
  .summary div {
    background: var(--card);
    border-radius: 18px;
    padding: 14px 16px;
    font-size: 14px;
    font-weight: 700;
    line-height: 1.35;
  }
  .summary small {
    display: block;
    color: var(--muted);
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    margin-bottom: 4px;
  }
  .doc h2 {
    font-size: 21px;
    letter-spacing: -0.02em;
    font-weight: 800;
    margin: 30px 0 8px;
  }
  .doc p,
  .doc li {
    font-size: 16px;
    line-height: 1.6;
  }
  .doc p + p {
    margin-top: 10px;
  }
  .doc ul {
    padding-left: 20px;
    margin-top: 8px;
  }
  .doc li + li {
    margin-top: 4px;
  }
  .doc a {
    color: inherit;
    font-weight: 700;
    text-decoration-thickness: 2px;
    text-underline-offset: 3px;
  }
  .doc .foot {
    margin-top: 40px;
    padding-top: 18px;
    border-top: 1px solid var(--line);
    color: var(--muted);
    font-size: 14px;
    font-weight: 600;
  }
</style>
